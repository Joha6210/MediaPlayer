[Unit]
Description=MediaPlayer Chromium kiosk
After=graphical.target mediaplayer-backend.service
Requires=mediaplayer-backend.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/usr/bin/chromium-browser --kiosk --incognito --noerrdialogs --disable-infobars --disable-session-crashed-bubble http://127.0.0.1:8090
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
